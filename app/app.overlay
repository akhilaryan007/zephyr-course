

/ {
    leds {
        compatible = "gpio-leds";

        red_led: led_0 {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
            label = "Red LED";
        };
    };

        our_driver0: our_driver0 {
            compatible = "iomico,sensor";
            status = "okay";
    };

    our_driver1: our_driver1 {
            compatible = "iomico,sensor";
            status = "okay";
    };

    aliases {
        app-led = &red_led;
    };
};


//app-led 